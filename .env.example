# ===== Plataforma Fênix — template de variáveis de ambiente =====
# Copie para .env com valores REAIS (NUNCA commitar o .env).

# Supabase (Postgres + Auth + Storage) — fonte exclusiva de dados
# Obter em: Supabase Dashboard -> Settings -> API
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ONLY=1

# JWT: segredo forte (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=""

# Vimeo API (https://developer.vimeo.com/apps)
VIMEO_CLIENT_ID=""
VIMEO_CLIENT_SECRET=""
VIMEO_ACCESS_TOKEN=""

# API Nipponflex (cadastro de D.I.s) — nunca logar os valores
NIPPONFLEX_BASE_URL=""
NIPPONFLEX_CODIGO=""
NIPPONFLEX_SENHA_MD5=""

# Opcionais (e-mail via SMTP — nodemailer)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=""
MAIL_FROM_NAME=""

# Opcional: domínio raiz do site (bloqueia Host forjado em admin/suporte)
# PUBLIC_BASE_DOMAIN=""
