import React, { useEffect, useState } from "react";
import { useStore } from "../store";
import Reveal from "./Reveal";
import { 
  Heart, 
  MessageCircle, 
  Share2, 
  PlusSquare, 
  Image as ImageIcon, 
  Video, 
  X, 
  Check, 
  Clock, 
  Send, 
  Sparkles, 
  Flame, 
  AlertCircle,
  ChevronLeft,
  ChevronRight,
  Calendar,
  UserCheck,
  Maximize2
} from "lucide-react";

export default function FenixSocialView() {
  const { 
    fenixPosts, 
    fetchFenixPosts, 
    likeFenixPost, 
    commentFenixPost, 
    createFenixPost, 
    loggedIn,
    user 
  } = useStore();

  const [isModalOpen, setIsModalOpen] = useState(false);
  
  // Creation Form State
  const [titulo, setTitulo] = useState("");
  const [legenda, setLegenda] = useState("");
  const [autorNome, setAutorNome] = useState("");
  const [usarDataAtual, setUsarDataAtual] = useState(true);
  const [dataPublicacao, setDataPublicacao] = useState(new Date().toISOString().substring(0, 10));

  // Selected Files
  const [selectedFiles, setSelectedFiles] = useState<{ base64: string; name: string; sizeStr: string; isVideo: boolean }[]>([]);

  const [submitting, setSubmitting] = useState(false);
  const [feedback, setFeedback] = useState<{ type: "success" | "error"; text: string } | null>(null);

  // Active comments dropdown toggle per post ID
  const [activeCommentPostId, setActiveCommentPostId] = useState<string | null>(null);
  const [commentText, setCommentText] = useState<{ [postId: string]: string }>({});
  const [commentSubmitting, setCommentSubmitting] = useState(false);

  // Copy link feedback
  const [copiedPostId, setCopiedPostId] = useState<string | null>(null);

  // Image slider active index map
  const [activeImageIndex, setActiveImageIndex] = useState<{ [postId: string]: number }>({});

  // Lightbox modal state for full resolution photos
  const [lightboxMedia, setLightboxMedia] = useState<{ url: string; title?: string } | null>(null);

  useEffect(() => {
    fetchFenixPosts();
  }, []);

  // Pre-fill autorNome when opening modal
  useEffect(() => {
    if (user) {
      setAutorNome(user.email ? user.email.split("@")[0] : (user.code === "admin" ? "Administrador FÃªnix" : "Membro FÃªnix"));
    }
  }, [user]);

  // Keep dataPublicacao updated if checkbox is checked
  useEffect(() => {
    if (usarDataAtual) {
      setDataPublicacao(new Date().toISOString().substring(0, 10));
    }
  }, [usarDataAtual]);

  // Handle File Selection (up to 3 photos or 1 video)
  const handleFilesChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = Array.from(e.target.files || []) as File[];
    if (files.length === 0) return;

    setFeedback(null);

    // Check if any video is included
    const hasVideo = files.some(f => f.type.toLowerCase().startsWith("video/"));

    if (hasVideo) {
      if (files.length > 1) {
        setFeedback({ type: "error", text: "Em caso de vÃ­deo, selecione apenas 1 vÃ­deo por publicaÃ§Ã£o." });
        return;
      }

      const videoFile = files[0];
      if (videoFile.size > 50 * 1024 * 1024) {
        setFeedback({ type: "error", text: "O vÃ­deo excede o tamanho mÃ¡ximo de 50 MB." });
        return;
      }

      const reader = new FileReader();
      reader.onload = () => {
        setSelectedFiles([{
          base64: reader.result as string,
          name: videoFile.name,
          sizeStr: (videoFile.size / (1024 * 1024)).toFixed(2) + " MB",
          isVideo: true
        }]);
      };
      reader.readAsDataURL(videoFile);
      return;
    }

    // Otherwise, all photos
    if (files.length > 3) {
      setFeedback({ type: "error", text: "Ã‰ permitido selecionar no mÃ¡ximo 3 fotos por publicaÃ§Ã£o." });
      return;
    }

    // Validate photo size (2MB max each)
    for (const photo of files) {
      if (photo.size > 2 * 1024 * 1024) {
        setFeedback({ type: "error", text: `A foto "${photo.name}" excede o tamanho mÃ¡ximo de 2 MB.` });
        return;
      }
    }

    // Convert all to base64
    const newFileObjs: { base64: string; name: string; sizeStr: string; isVideo: boolean }[] = [];
    let readCount = 0;

    files.forEach(f => {
      const reader = new FileReader();
      reader.onload = () => {
        newFileObjs.push({
          base64: reader.result as string,
          name: f.name,
          sizeStr: (f.size / (1024 * 1024)).toFixed(2) + " MB",
          isVideo: false
        });
        readCount++;
        if (readCount === files.length) {
          setSelectedFiles(newFileObjs);
        }
      };
      reader.readAsDataURL(f);
    });
  };

  const handleRemoveFile = (index: number) => {
    setSelectedFiles(prev => prev.filter((_, i) => i !== index));
  };

  const handleCreateSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!titulo.trim()) {
      setFeedback({ type: "error", text: "Por favor, preencha o tÃ­tulo da publicaÃ§Ã£o." });
      return;
    }
    if (!legenda.trim()) {
      setFeedback({ type: "error", text: "Por favor, adicione a descriÃ§Ã£o da publicaÃ§Ã£o." });
      return;
    }
    if (!autorNome.trim()) {
      setFeedback({ type: "error", text: "Por favor, informe o nome do autor." });
      return;
    }
    if (selectedFiles.length === 0) {
      setFeedback({ type: "error", text: "Por favor, selecione ao menos 1 foto ou 1 vÃ­deo." });
      return;
    }

    setSubmitting(true);
    setFeedback(null);

    const isVid = selectedFiles[0].isVideo;
    const filesBase64 = selectedFiles.map(f => f.base64);

    const res = await createFenixPost({
      titulo: titulo.trim(),
      legenda: legenda.trim(),
      usuarioNome: autorNome.trim(),
      dataPublicacao: usarDataAtual ? new Date().toISOString().substring(0, 10) : dataPublicacao,
      filesBase64,
      tipoMedia: isVid ? "video" : "photo"
    });

    setSubmitting(false);

    if (res.success) {
      setFeedback({
        type: "success",
        text: res.message || "PublicaÃ§Ã£o enviada com sucesso! Ela passarÃ¡ por anÃ¡lise de moderaÃ§Ã£o."
      });
      setTimeout(() => {
        setIsModalOpen(false);
        setTitulo("");
        setLegenda("");
        setSelectedFiles([]);
        setFeedback(null);
      }, 2500);
    } else {
      setFeedback({
        type: "error",
        text: res.error || "Ocorreu um erro ao enviar a publicaÃ§Ã£o."
      });
    }
  };

  const handleSharePost = (id: string) => {
    const shareUrl = `${window.location.origin}/?post=${id}`;
    navigator.clipboard.writeText(shareUrl);
    setCopiedPostId(id);
    setTimeout(() => setCopiedPostId(null), 2500);
  };

  const handleSendComment = async (postId: string) => {
    const text = commentText[postId]?.trim();
    if (!text) return;

    setCommentSubmitting(true);
    const success = await commentFenixPost(postId, text);
    setCommentSubmitting(false);

    if (success) {
      setCommentText((prev) => ({ ...prev, [postId]: "" }));
    }
  };

  return (
    <div className="min-h-screen py-8 px-4 sm:px-6 md:px-8 max-w-2xl md:max-w-4xl lg:max-w-5xl xl:max-w-6xl mx-auto animate-fade-in">
      {/* Header Banner */}
      <div className="relative rounded-2xl bg-gradient-to-r from-[#0f141c] via-[#1a202c] to-[#0f141c] border border-white/10 p-5 sm:p-8 mb-6 sm:mb-8 overflow-hidden shadow-2xl">
        <div className="absolute top-0 right-0 -mt-8 -mr-8 w-64 h-64 bg-[#d12a62]/10 rounded-full blur-3xl pointer-events-none"></div>
        <Reveal direction="up" className="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
          <div>
            <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#d12a62]/20 border border-[#d12a62]/30 text-[#d12a62] text-xs font-semibold mb-3">
              <Flame className="w-3.5 h-3.5" /> FÃªnix Social
            </div>
            <h1 className="text-2xl sm:text-3xl font-black text-white tracking-tight font-display">
              Comunidade & ConteÃºdos
            </h1>
            <p className="text-sm text-[#94a3b8] mt-1 max-w-xl">
              Compartilhe conquistas, momentos e criaÃ§Ãµes com toda a comunidade FÃªnix. Fotos e vÃ­deos aprovados ficam visÃ­veis para todos!
            </p>
          </div>

          {/* CRITICAL: Publication button rendered ONLY if loggedIn is true */}
          {loggedIn && (
            <button
              id="nova-publicacao-btn"
              onClick={() => setIsModalOpen(true)}
              className="flex items-center justify-center gap-2 px-4 py-2.5 sm:px-5 sm:py-3 rounded-xl bg-gradient-to-r from-[#881337] via-[#d12a62] to-[#b91c1c] hover:opacity-90 text-white font-bold text-xs sm:text-sm transition-all shadow-lg shadow-[#d12a62]/20 flex-shrink-0 cursor-pointer w-full sm:w-auto mt-2 sm:mt-0"
            >
              <PlusSquare className="w-4 h-4 sm:w-4.5 sm:h-4.5" /> Nova PublicaÃ§Ã£o
            </button>
          )}
        </Reveal>
      </div>

      {/* Feed Stack - Instagram Centered Feed */}
      {fenixPosts.length === 0 ? (
        <div className="text-center py-16 px-4 bg-white/5 rounded-2xl border border-white/[0.06]">
          <Sparkles className="w-12 h-12 text-[#d12a62] mx-auto mb-3 opacity-60 animate-pulse" />
          <h3 className="text-lg font-bold text-white mb-1">Nenhuma publicaÃ§Ã£o no momento</h3>
          <p className="text-sm text-[#94a3b8] max-w-md mx-auto mb-6">
            Seja o primeiro a compartilhar uma foto ou vÃ­deo com a comunidade FÃªnix!
          </p>
          {loggedIn && (
            <button
              onClick={() => setIsModalOpen(true)}
              className="px-5 py-2.5 rounded-xl bg-[#d12a62] hover:bg-[#b91c1c] text-white text-xs font-bold transition-all cursor-pointer"
            >
              Criar Primeira PublicaÃ§Ã£o
            </button>
          )}
        </div>
      ) : (
        <div className="flex flex-col items-center w-full space-y-8 cv-auto">
          {fenixPosts.map((post) => {
            const mediaList: string[] = post.mediaUrls && post.mediaUrls.length > 0 ? post.mediaUrls : [post.mediaUrl];
            const currentImgIndex = activeImageIndex[post.id] || 0;

            return (
              <div 
                key={post.id} 
                id={`fpost-card-${post.id}`}
                className="w-full bg-[#0b0f17] rounded-2xl border border-white/10 overflow-hidden shadow-2xl flex flex-col transition-all hover:border-white/20"
              >
                {/* User Header */}
                <div className="p-4 flex items-center justify-between border-b border-white/5 bg-white/[0.02]">
                  <div className="flex items-center gap-3">
                    <div className="w-10 h-10 rounded-full bg-[#d12a62]/20 border border-[#d12a62]/40 flex items-center justify-center text-[#d12a62] font-bold text-sm">
                      {post.usuarioNome ? post.usuarioNome.charAt(0).toUpperCase() : "F"}
                    </div>
                    <div>
                      <h4 className="text-sm font-bold text-white">{post.usuarioNome}</h4>
                    </div>
                  </div>
                  <div className="text-xs text-[#64748b] font-mono flex items-center gap-1 bg-white/5 px-2.5 py-1 rounded-lg border border-white/5">
                    <Clock className="w-3.5 h-3.5" />
                    {post.dataPublicacao 
                      ? new Date(post.dataPublicacao + "T12:00:00").toLocaleDateString("pt-BR")
                      : new Date(post.createdAt).toLocaleDateString("pt-BR")}
                  </div>
                </div>

                {/* Title if present */}
                {post.titulo && (
                  <div className="px-4 py-2.5 bg-white/[0.03] border-b border-white/5">
                    <h3 className="text-sm font-bold text-amber-400 tracking-tight">{post.titulo}</h3>
                  </div>
                )}

                {/* Media Display - Proportional Aspect Ratio for Vertical and Horizontal Media */}
                <div className="relative bg-black flex items-center justify-center overflow-hidden w-full min-h-[320px] md:min-h-[500px] lg:min-h-[600px] max-h-[640px] md:max-h-[850px] lg:max-h-[1000px] group select-none">
                  {post.tipoMedia === "video" ? (
                    <video 
                      src={mediaList[0]} 
                      controls 
                      playsInline
                      preload="metadata"
                      className="w-full h-auto max-h-[640px] md:max-h-[850px] lg:max-h-[1000px] object-contain bg-black"
                    />
                  ) : (
                    <div className="relative w-full h-full flex items-center justify-center bg-black/95">
                      <img loading="lazy" decoding="async" 
                        src={mediaList[currentImgIndex]} 
                        alt={post.titulo || post.legenda} 
                        className="w-full h-auto max-h-[640px] md:max-h-[850px] lg:max-h-[1000px] object-contain transition-all duration-300 cursor-zoom-in"
                        onClick={() => setLightboxMedia({ url: mediaList[currentImgIndex], title: post.titulo })}
                        referrerPolicy="no-referrer"
                      />

                      {/* Expand Button */}
                      <button
                        onClick={(e) => {
                          e.stopPropagation();
                          setLightboxMedia({ url: mediaList[currentImgIndex], title: post.titulo });
                        }}
                        className="absolute top-3 right-3 p-2 rounded-xl bg-black/70 hover:bg-black/90 text-white border border-white/20 backdrop-blur-md opacity-80 sm:opacity-0 group-hover:opacity-100 transition-opacity z-10 cursor-pointer shadow-lg"
                        title="Ampliar Foto"
                      >
                        <Maximize2 className="w-4 h-4" />
                      </button>

                      {/* Instagram Carousel Navigation Arrows */}
                      {mediaList.length > 1 && (
                        <>
                          {currentImgIndex > 0 && (
                            <button
                              onClick={() => setActiveImageIndex({ ...activeImageIndex, [post.id]: currentImgIndex - 1 })}
                              className="absolute left-3 top-1/2 -translate-y-1/2 p-2 rounded-full bg-black/70 text-white border border-white/20 hover:bg-black/90 transition-all opacity-80 group-hover:opacity-100 cursor-pointer"
                              title="Foto anterior"
                            >
                              <ChevronLeft className="w-5 h-5" />
                            </button>
                          )}

                          {currentImgIndex < mediaList.length - 1 && (
                            <button
                              onClick={() => setActiveImageIndex({ ...activeImageIndex, [post.id]: currentImgIndex + 1 })}
                              className="absolute right-3 top-1/2 -translate-y-1/2 p-2 rounded-full bg-black/70 text-white border border-white/20 hover:bg-black/90 transition-all opacity-80 group-hover:opacity-100 cursor-pointer"
                              title="PrÃ³xima foto"
                            >
                              <ChevronRight className="w-5 h-5" />
                            </button>
                          )}

                          {/* Indicator Badge */}
                          <div className="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-black/70 backdrop-blur-md text-white text-[10px] font-bold tracking-wider border border-white/10">
                            {currentImgIndex + 1}/{mediaList.length}
                          </div>

                          {/* Dot Indicators */}
                          <div className="absolute bottom-3 inset-x-0 flex justify-center gap-1.5 z-10">
                            {mediaList.map((_, dotIdx) => (
                              <button
                                key={dotIdx}
                                onClick={() => setActiveImageIndex({ ...activeImageIndex, [post.id]: dotIdx })}
                                className={`w-2 h-2 rounded-full transition-all cursor-pointer ${
                                  dotIdx === currentImgIndex ? "bg-[#d12a62] w-4" : "bg-white/50 hover:bg-white"
                                }`}
                              />
                            ))}
                          </div>
                        </>
                      )}
                    </div>
                  )}
                </div>

                {/* Caption / Description */}
                <div className="p-4 bg-white/[0.01]">
                  <p className="text-xs sm:text-sm text-[#e2e8f0] leading-relaxed whitespace-pre-line">
                    {post.legenda}
                  </p>
                </div>

                {/* Action Bar with Embedded Comment Input */}
                <div className="px-4 py-3 bg-white/[0.02] border-t border-b border-white/5 flex flex-col sm:flex-row sm:items-center gap-2.5">
                  <div className="flex items-center gap-2 flex-shrink-0">
                    {/* Like Button */}
                    <button
                      id={`like-btn-${post.id}`}
                      onClick={() => likeFenixPost(post.id)}
                      className="flex items-center gap-2 px-3 py-2 rounded-xl bg-white/5 hover:bg-[#d12a62]/10 text-xs font-semibold text-white hover:text-[#d12a62] transition-colors cursor-pointer"
                      title="Curtir publicaÃ§Ã£o"
                    >
                      <Heart className={`w-4 h-4 ${post.likes > 0 ? "fill-[#d12a62] text-[#d12a62]" : "text-[#94a3b8]"}`} />
                      <span>{post.likes}</span>
                    </button>

                    {/* Share Button */}
                    <button
                      id={`share-btn-${post.id}`}
                      onClick={() => handleSharePost(post.id)}
                      className="flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-semibold text-[#94a3b8] hover:text-white transition-colors cursor-pointer"
                      title="Copiar link direto"
                    >
                      {copiedPostId === post.id ? (
                        <Check className="w-4 h-4 text-emerald-400" />
                      ) : (
                        <Share2 className="w-4 h-4" />
                      )}
                    </button>
                  </div>

                  {/* Embedded Comment Input Field */}
                  <div className="flex-grow flex items-center gap-2">
                    <input
                      type="text"
                      placeholder="Adicione um comentÃ¡rio..."
                      value={commentText[post.id] || ""}
                      onChange={(e) => setCommentText({ ...commentText, [post.id]: e.target.value })}
                      onKeyDown={(e) => {
                        if (e.key === "Enter") handleSendComment(post.id);
                      }}
                      className="w-full px-3.5 py-2 rounded-xl bg-white/5 border border-white/10 text-xs text-white placeholder-[#64748b] focus:outline-none focus:border-[#d12a62] transition-colors"
                    />
                    <button
                      onClick={() => handleSendComment(post.id)}
                      disabled={commentSubmitting || !(commentText[post.id]?.trim())}
                      className="px-3.5 py-2 rounded-xl bg-[#d12a62] hover:bg-[#b91c1c] text-white transition-all disabled:opacity-40 flex items-center gap-1.5 font-bold text-xs cursor-pointer flex-shrink-0"
                    >
                      <Send className="w-3.5 h-3.5" />
                      <span className="hidden sm:inline">Comentar</span>
                    </button>
                  </div>
                </div>

                {/* Dynamically Expanding Comments Section */}
                {post.comentarios && post.comentarios.length > 0 && (
                  <div className="p-4 bg-[#07090e] space-y-2.5 transition-all">
                    <div className="flex items-center justify-between">
                      <span className="text-[11px] font-bold text-[#94a3b8] uppercase tracking-wider flex items-center gap-1.5">
                        <MessageCircle className="w-3.5 h-3.5 text-[#d12a62]" /> ComentÃ¡rios ({post.comentarios.length})
                      </span>
                    </div>

                    <div className="space-y-2">
                      {post.comentarios.map((c) => (
                        <div key={c.id} className="p-3 rounded-xl bg-white/5 text-xs border border-white/[0.04] space-y-1 transition-all">
                          <div className="flex items-center justify-between">
                            <span className="font-bold text-[#d12a62]">{c.usuarioNome}</span>
                            <span className="text-[10px] text-[#64748b]">
                              {new Date(c.createdAt).toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" })}
                            </span>
                          </div>
                          <p className="text-[#e2e8f0] leading-snug whitespace-pre-line">{c.texto}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}

      {/* Fullscreen Lightbox Modal */}
      {lightboxMedia && (
        <div 
          className="fixed inset-0 z-50 bg-black/90 backdrop-blur-md flex items-center justify-center p-4 animate-fade-in"
          onClick={() => setLightboxMedia(null)}
        >
          <button
            onClick={() => setLightboxMedia(null)}
            className="absolute top-4 right-4 p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors cursor-pointer z-10"
            title="Fechar"
          >
            <X className="w-6 h-6" />
          </button>
          <div className="max-w-4xl max-h-[90vh] flex flex-col items-center justify-center" onClick={(e) => e.stopPropagation()}>
            <img loading="lazy" decoding="async" 
              src={lightboxMedia.url} 
              alt={lightboxMedia.title || "Foto ampliada"} 
              className="max-w-full max-h-[85vh] object-contain rounded-xl shadow-2xl border border-white/10"
              referrerPolicy="no-referrer"
            />
            {lightboxMedia.title && (
              <p className="mt-3 text-sm text-gray-300 font-semibold text-center">{lightboxMedia.title}</p>
            )}
          </div>
        </div>
      )}

      {/* Upload Modal (Strictly for Logged-In Users) */}
      {isModalOpen && loggedIn && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md animate-fade-in overflow-y-auto">
          <div className="bg-[#0b0f17] border border-white/10 rounded-2xl max-w-lg w-full p-6 shadow-2xl relative my-8">
            <button
              onClick={() => setIsModalOpen(false)}
              className="absolute top-4 right-4 text-[#94a3b8] hover:text-white p-1 rounded-lg hover:bg-white/5 transition-colors"
            >
              <X className="w-5 h-5" />
            </button>

            <div className="flex items-center gap-3 mb-6">
              <div className="w-10 h-10 rounded-xl bg-[#d12a62]/20 border border-[#d12a62]/30 flex items-center justify-center text-[#d12a62]">
                <PlusSquare className="w-5 h-5" />
              </div>
              <div>
                <h3 className="text-lg font-bold text-white font-display">Criar Nova PublicaÃ§Ã£o FÃªnix</h3>
                <p className="text-xs text-[#94a3b8]">Preencha as informaÃ§Ãµes e faÃ§a upload do conteÃºdo</p>
              </div>
            </div>

            {feedback && (
              <div className={`p-3 rounded-xl mb-4 text-xs flex items-start gap-2 ${
                feedback.type === "success" 
                  ? "bg-emerald-950/40 border border-emerald-500/30 text-emerald-300" 
                  : "bg-red-950/40 border border-red-500/30 text-red-300"
              }`}>
                <AlertCircle className="w-4 h-4 flex-shrink-0 mt-0.5" />
                <span>{feedback.text}</span>
              </div>
            )}

            <form onSubmit={handleCreateSubmit} className="space-y-4">
              {/* TÃ­tulo da PublicaÃ§Ã£o */}
              <div>
                <label className="block text-xs font-semibold text-[#cbd5e1] mb-1">
                  TÃ­tulo da PublicaÃ§Ã£o <span className="text-[#d12a62]">*</span>
                </label>
                <input
                  type="text"
                  required
                  value={titulo}
                  onChange={(e) => setTitulo(e.target.value)}
                  placeholder="Ex: Treinamento Especial de Biohacking FÃªnix"
                  className="w-full px-3 py-2 rounded-xl bg-white/5 border border-white/10 text-xs text-white placeholder-[#64748b] focus:outline-none focus:border-[#d12a62]"
                />
              </div>

              {/* DescriÃ§Ã£o da PublicaÃ§Ã£o */}
              <div>
                <label className="block text-xs font-semibold text-[#cbd5e1] mb-1">
                  DescriÃ§Ã£o da PublicaÃ§Ã£o <span className="text-[#d12a62]">*</span>
                </label>
                <textarea
                  rows={3}
                  required
                  value={legenda}
                  onChange={(e) => setLegenda(e.target.value)}
                  placeholder="Escreva uma descriÃ§Ã£o completa sobre a publicaÃ§Ã£o..."
                  className="w-full px-3 py-2 rounded-xl bg-white/5 border border-white/10 text-xs text-white placeholder-[#64748b] focus:outline-none focus:border-[#d12a62]"
                />
              </div>

              {/* Autor da PublicaÃ§Ã£o */}
              <div>
                <label className="block text-xs font-semibold text-[#cbd5e1] mb-1">
                  Nome do Autor da PublicaÃ§Ã£o <span className="text-[#d12a62]">*</span>
                </label>
                <div className="relative">
                  <UserCheck className="w-4 h-4 text-[#64748b] absolute left-3 top-1/2 -translate-y-1/2" />
                  <input
                    type="text"
                    required
                    value={autorNome}
                    onChange={(e) => setAutorNome(e.target.value)}
                    placeholder="Seu nome ou nome do autor"
                    className="w-full pl-9 pr-3 py-2 rounded-xl bg-white/5 border border-white/10 text-xs text-white placeholder-[#64748b] focus:outline-none focus:border-[#d12a62]"
                  />
                </div>
              </div>

              {/* Data da PublicaÃ§Ã£o & Checkbox Data Atual */}
              <div className="bg-white/[0.02] p-3 rounded-xl border border-white/5 space-y-2">
                <div className="flex items-center justify-between">
                  <label className="text-xs font-semibold text-[#cbd5e1] flex items-center gap-1.5">
                    <Calendar className="w-3.5 h-3.5 text-[#d12a62]" /> Data da PublicaÃ§Ã£o
                  </label>

                  <label className="flex items-center gap-2 cursor-pointer text-xs text-amber-400 select-none">
                    <input
                      type="checkbox"
                      checked={usarDataAtual}
                      onChange={(e) => setUsarDataAtual(e.target.checked)}
                      className="rounded bg-white/10 border-white/20 text-[#d12a62] focus:ring-[#d12a62]"
                    />
                    Usar data atual de hoje
                  </label>
                </div>

                {!usarDataAtual && (
                  <input
                    type="date"
                    value={dataPublicacao}
                    onChange={(e) => setDataPublicacao(e.target.value)}
                    className="w-full px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-xs text-white focus:outline-none focus:border-[#d12a62]"
                  />
                )}
              </div>

              {/* File Dropzone / Select */}
              <div>
                <label className="block text-xs font-semibold text-[#cbd5e1] mb-1">
                  Upload de Arquivos <span className="text-[#d12a62]">*</span>
                </label>

                <div className="border-2 border-dashed border-white/10 hover:border-[#d12a62]/50 rounded-xl p-4 text-center cursor-pointer transition-colors bg-white/[0.01]">
                  <input
                    type="file"
                    multiple
                    accept="image/jpeg,image/png,image/webp,video/mp4,video/webm"
                    onChange={handleFilesChange}
                    className="hidden"
                    id="fenix-file-input"
                  />
                  <label htmlFor="fenix-file-input" className="cursor-pointer block">
                    {selectedFiles.length > 0 ? (
                      <div className="space-y-3">
                        <div className="grid grid-cols-3 gap-2">
                          {selectedFiles.map((fileObj, idx) => (
                            <div key={idx} className="relative group bg-black/60 rounded-lg overflow-hidden border border-white/10">
                              {fileObj.isVideo ? (
                                <div className="h-20 flex flex-col items-center justify-center p-1 text-amber-400">
                                  <Video className="w-6 h-6 mb-1" />
                                  <span className="text-[9px] truncate max-w-full">{fileObj.name}</span>
                                </div>
                              ) : (
                                <img loading="lazy" decoding="async" src={fileObj.base64} alt="Preview" className="h-20 w-full object-cover" />
                              )}
                              <button
                                type="button"
                                onClick={(e) => {
                                  e.preventDefault();
                                  e.stopPropagation();
                                  handleRemoveFile(idx);
                                }}
                                className="absolute top-1 right-1 p-1 bg-black/80 rounded-full text-red-400 hover:text-red-200"
                                title="Remover"
                              >
                                <X className="w-3 h-3" />
                              </button>
                            </div>
                          ))}
                        </div>
                        <span className="text-[11px] text-[#d12a62] underline font-semibold block">Clique para alterar seleÃ§Ã£o de arquivos</span>
                      </div>
                    ) : (
                      <div className="py-4 space-y-2">
                        <div className="flex items-center justify-center gap-3 text-[#94a3b8]">
                          <ImageIcon className="w-6 h-6" />
                          <Video className="w-6 h-6" />
                        </div>
                        <p className="text-xs text-[#e2e8f0] font-medium">Clique para selecionar Fotos (atÃ© 3) ou VÃ­deo (mÃ¡x. 1)</p>
                        <p className="text-[10px] text-[#64748b]">Fotos: atÃ© 3 unidades (mÃ¡x. 2MB cada) | VÃ­deo: 1 unidade (mÃ¡x. 50MB)</p>
                      </div>
                    )}
                  </label>
                </div>
              </div>

              {/* Submit Buttons */}
              <div className="pt-2 flex items-center justify-end gap-3">
                <button
                  type="button"
                  onClick={() => setIsModalOpen(false)}
                  className="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-semibold text-[#94a3b8] hover:text-white transition-colors"
                >
                  Cancelar
                </button>
                <button
                  type="submit"
                  disabled={submitting}
                  className="px-5 py-2 rounded-xl bg-gradient-to-r from-[#881337] via-[#d12a62] to-[#b91c1c] text-white text-xs font-bold transition-all shadow-lg shadow-[#d12a62]/20 disabled:opacity-50"
                >
                  {submitting ? "Enviando..." : "Enviar PublicaÃ§Ã£o"}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}

